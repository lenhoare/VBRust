' calendar — print a month grid from pure date maths (no Date type in VBR).
' Sakamoto's day-of-week algorithm, leap years, and column alignment.
' Tests: Int() truncation, Mod, Vec literals, Space() if it exists.

Function IsLeap(ByVal y As Long) As Boolean
    Return (y Mod 4 = 0 And y Mod 100 <> 0) Or (y Mod 400 = 0)
End Function

Function DaysInMonth(ByVal m As Long, ByVal y As Long) As Long
    Match m
        1 | 3 | 5 | 7 | 8 | 10 | 12 => Return 31
        4 | 6 | 9 | 11 => Return 30
        2 => If IsLeap(y) Then Return 29 Else Return 28
        _ => RaiseError "month out of range: " & m
    End Match
End Function

' 0 = Sunday. Sakamoto's algorithm.
Function DayOfWeek(ByVal d As Long, ByVal m As Long, ByVal y As Long) As Long
    Dim t As Vec<Long> = [0, 3, 2, 5, 0, 3, 5, 1, 4, 6, 2, 4]
    Dim yy As Long = y
    If m < 3 Then
        yy = yy - 1
    End If
    Return (yy + Int(yy / 4) - Int(yy / 100) + Int(yy / 400) + t[m - 1] + d) Mod 7
End Function

Function MonthName(ByVal m As Long) As String
    Dim names As Vec<String> = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"]
    Return names[m - 1]
End Function

Function TwoDigits(ByVal n As Long) As String
    If n < 10 Then
        Return " " & n
    End If
    Return "" & n
End Function

' VB6's Space$ isn't built in — hand-rolled (F-008).
Function Spaces(ByVal n As Long) As String
    Dim out As String = ""
    Dim i As Long
    For i = 1 To n
        out = out & " "
    Next
    Return out
End Function

Function PrintMonth(ByVal m As Long, ByVal y As Long)
    Dim title As String = MonthName(m) & " " & y
    Debug.Print Spaces(Int((20 - Len(title)) / 2)) & title
    Debug.Print "Su Mo Tu We Th Fr Sa"
    Dim lead As Long = DayOfWeek(1, m, y)
    Dim row As String = Spaces(lead * 3)
    Dim d As Long
    For d = 1 To DaysInMonth(m, y)
        row = row & TwoDigits(d)
        If (lead + d) Mod 7 = 0 Or d = DaysInMonth(m, y) Then
            Debug.Print row
            row = ""
        Else
            row = row & " "
        End If
    Next
End Function

Function Main()
    PrintMonth(8, 2026)
    Debug.Print ""
    PrintMonth(2, 2024)
    Debug.Print ""
    PrintMonth(2, 2026)
End Function
