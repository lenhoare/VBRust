' Standard library — DateTime and Json are value types you hold and use
Function Main()
    Dim now As DateTime = DateTime.Now()
    Debug.Print "this year: " & now.Year()
    Dim later As DateTime = now.Add_Days(30)
    Debug.Print "in 30 days: " & later.Format("%Y-%m-%d")

    Dim person As Json = Json.Parse("{""name"":""Alice"",""age"":42}")
    Debug.Print "name = " & person.Get_String("name")
    Debug.Print "age  = " & person.Get_Int("age")

    Dim doc As Json = Json.Parse("{""tags"":[""red"",""green"",""blue""]}")
    Dim tags As Vec<Json> = doc.Get_Array("tags")
    Debug.Print "tag count: " & tags.Len()
    For Each tag In tags
        Debug.Print "  tag: " & tag.As_String()
    Next
End Function
