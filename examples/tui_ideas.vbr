' tui_ideas.vbr — a fallible State initialiser (a helper that Opens SQLite)
' runs *before* the terminal starts: if it fails, you get "could not start: <why>"
' and a clean exit. Events must not Query/Execute on the UI thread — that would
' freeze the screen — so Add is `Match Await AddIdea()` and the Function opens
' its own connection off-thread.
Screen Ideas
    Title "Idea Store"

    State
        Dim status As String = "a = add an idea, q = quit"
        Dim count As Long = StartupCount()
    End State

    View
        Column
            Text "Ideas stored: " & count
            Text status
        End Column
    End View

    On Key "a" Add
    On Key "q" Quit

    Event Add
        Match Await AddIdea()
            Ok(n) =>
                count = n
                status = "added — " & n & " ideas now (+" & BonusPoints() & " bonus)"
            Err(e) => status = "error: " & e
        End Match
    End Event
End Screen

Function StartupCount() As Long
    Dim db As Database = Database.Open("ideas.db")
    db.Execute("CREATE TABLE IF NOT EXISTS ideas (id INTEGER PRIMARY KEY, text TEXT)", [])
    Dim rows As Vec<Json> = db.Query("SELECT COUNT(*) AS n FROM ideas", [])
    Return rows[0].Get_Int("n")
End Function

Function AddIdea() As Long
    Dim db As Database = Database.Open("ideas.db")
    db.Execute("CREATE TABLE IF NOT EXISTS ideas (id INTEGER PRIMARY KEY, text TEXT)", [])
    db.Execute("INSERT INTO ideas (text) VALUES (?)", ["a fresh idea"])
    Dim rows As Vec<Json> = db.Query("SELECT COUNT(*) AS n FROM ideas", [])
    Return rows[0].Get_Int("n")
End Function

' A HashMap built inside a plain helper (not an event) still needs the file-top
' `use std::collections::HashMap;`. The surface import scan reads helper bodies
' too now, not only events — before, a Screen whose only HashMap lived in a
' helper compiled to code referencing an unimported type.
Function BonusPoints() As Long
    Dim weights As HashMap<String, Long>
    weights.Insert("base", 3)
    weights.Insert("streak", 2)
    Return weights.Len()
End Function

Function Main()
    Ideas.Run
End Function
