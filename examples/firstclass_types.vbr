' Result<T>, Option<T> and Vec<T> as first-class parameter and return types.
Function Main()
    Dim evens As Vec<Long> = EvensUpTo(10)
    Debug.Print "evens count = " & evens.len()

    Match FirstWord("hello world")
        Some(w) => Debug.Print "first word = " & w
        None => Debug.Print "no words"
    End Match

    Dim parts As Vec<String> = Lines("a,b,c")
    Debug.Print "parts = " & parts.len()
End Function

' Returns a Vec by value.
Function EvensUpTo(ByVal limit As Long) As Vec<Long>
    Dim result As Vec<Long>
    Dim n As Long = 0
    Do While n <= limit
        result.push(n)
        n = n + 2
    Loop
    Return result
End Function

' Returns an Option by value.
Function FirstWord(ByVal text As String) As Option<String>
    If Len(text) = 0 Then
        Return None
    End If
    Return Some(text)
End Function

' A nested wrapper: a function that returns Vec<String>, and can fail.
Function Lines(ByVal text As String) As Vec<String>
    If Len(text) = 0 Then
        RaiseError "empty input"
    End If
    Dim parts As Vec<String>
    parts.push(text)
    Return parts
End Function
