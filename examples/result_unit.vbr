' A fallible action that returns no value on success. RaiseError fails; a
' bare End Function is success. Intercept at the call with Handle.
Function Save(ByVal ok As Boolean)
    If Not ok Then
        RaiseError "save failed"
    End If
End Function

Function Main()
    Save(True) Handle e
        Debug.Print "error: " & e
        Return
    End Handle
    Debug.Print "saved"

    Save(False) Handle e
        Debug.Print "error: " & e
        Return
    End Handle
    Debug.Print "saved"
End Function
