' Pac-Man — grid-aligned movement. Position is kept as scalars (px, py) and only
' turned into a Vector2 to place the sprite. He glides toward the centre of a
' target tile; on arriving he may turn (if the wanted direction is open) and steps
' to the next tile unless it's a wall. Collision via Maze.IsBlocked.
'
' He also watches the four ghosts: if one overlaps him he loses a life and starts
' again from his home tile (the ghost independently sends itself home). At zero
' lives the game freezes.

Sprite2D "Pacman"
    Export Speed As Single = 70.0
    Dim tileX As Long = 13
    Dim tileY As Long = 23
    Dim dx As Long = 0
    Dim dy As Long = 0
    Dim wantX As Long = 0
    Dim wantY As Long = 0
    Dim px As Single = 108
    Dim py As Single = 188
    Dim score As Long = 0
    Dim lives As Long = 3
    Dim dead As Boolean = False
    Dim wasHit As Boolean = False
    Dim eaten As Vec<Boolean>

    On Ready
        ' One flag per tile (28 x 31 = 868), so a pellet is only eaten once.
        Dim i As Long = 0
        For i = 0 To 867
            eaten.Push(False)
        Next
    End Ready

    On Process(delta)
        If Not dead Then
            ' Queue the wanted direction (applied at the next tile centre).
            If Input.IsPressed("ui_right") Then
                wantX = 1
                wantY = 0
            End If
            If Input.IsPressed("ui_left") Then
                wantX = -1
                wantY = 0
            End If
            If Input.IsPressed("ui_up") Then
                wantX = 0
                wantY = -1
            End If
            If Input.IsPressed("ui_down") Then
                wantX = 0
                wantY = 1
            End If

            Dim gx As Single = tileX * 8 + 4
            Dim gy As Single = tileY * 8 + 4
            Dim mv As Single = Speed * delta

            If Abs(gx - px) + Abs(gy - py) <= mv Then
                ' Arrived at the target centre — snap, eat, then choose the next tile.
                px = gx
                py = gy

                ' Eat the pellet on this tile (once), score, and black it out.
                Dim idx As Long = tileY * 28 + tileX
                If Maze.HasPellet(tileX, tileY) And Not eaten[idx] Then
                    eaten[idx] = True
                    score = score + 10
                    Debug.Print "score: " & score
                    Dim cover As ColorRect = Spawn("res://cover.tscn")
                    cover.SetPosition(Vector2(tileX * 8, tileY * 8))
                    Dim board As Node = Me.GetNode("..")
                    board.AddChild(cover)
                End If

                If Not Maze.IsBlocked(tileX + wantX, tileY + wantY) Then
                    dx = wantX
                    dy = wantY
                End If
                If Not Maze.IsBlocked(tileX + dx, tileY + dy) Then
                    tileX = tileX + dx
                    tileY = tileY + dy
                End If
            Else
                ' Glide toward the target centre.
                If gx > px Then px = px + mv
                If gx < px Then px = px - mv
                If gy > py Then py = py + mv
                If gy < py Then py = py - mv
            End If
        End If

        Me.Position = Vector2(px, py)

        ' Face the direction of travel (open-mouth frame).
        If dx > 0 Then Me.RegionRect = Rect2(0, 0, 16, 16)
        If dx < 0 Then Me.RegionRect = Rect2(0, 16, 16, 16)
        If dy < 0 Then Me.RegionRect = Rect2(0, 32, 16, 16)
        If dy > 0 Then Me.RegionRect = Rect2(0, 48, 16, 16)

        ' Did a ghost catch me? (Any of the four overlapping counts.)
        If Not dead Then
            Dim hit As Boolean = False

            Dim b As Node2D = Me.GetNode("../Blinky")
            Dim bp As Vector2 = b.GetPosition()
            Dim bx As Single = bp.X
            Dim by As Single = bp.Y
            If Abs(px - bx) + Abs(py - by) < 6 Then
                hit = True
            End If

            Dim p As Node2D = Me.GetNode("../Pinky")
            Dim pp As Vector2 = p.GetPosition()
            Dim pkx As Single = pp.X
            Dim pky As Single = pp.Y
            If Abs(px - pkx) + Abs(py - pky) < 6 Then
                hit = True
            End If

            Dim n As Node2D = Me.GetNode("../Inky")
            Dim np As Vector2 = n.GetPosition()
            Dim nx As Single = np.X
            Dim ny As Single = np.Y
            If Abs(px - nx) + Abs(py - ny) < 6 Then
                hit = True
            End If

            Dim c As Node2D = Me.GetNode("../Clyde")
            Dim cp As Vector2 = c.GetPosition()
            Dim cx As Single = cp.X
            Dim cy As Single = cp.Y
            If Abs(px - cx) + Abs(py - cy) < 6 Then
                hit = True
            End If

            If hit And Not wasHit Then
                lives = lives - 1
                Debug.Print "caught! lives: " & lives
                If lives <= 0 Then
                    dead = True
                    Debug.Print "GAME OVER"
                End If
                ' Back to the home tile.
                tileX = 13
                tileY = 23
                dx = 0
                dy = 0
                wantX = 0
                wantY = 0
                px = 108
                py = 188
            End If
            wasHit = hit
        End If
    End Process
End Sprite2D
