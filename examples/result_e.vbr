' Typed errors are strings on the implicit Result<T, String> channel.
' RaiseError fails; Handle intercepts a call and binds the message.
Function SafeDiv(ByVal a As Integer, ByVal b As Integer) As Integer
    If b = 0 Then
        RaiseError "div by zero"
    End If
    If b < 0 Then
        RaiseError "negative divisor"
    End If
    Return a / b
End Function

Function DoubleDiv(ByVal a As Integer, ByVal b As Integer) As Integer
    Dim q As Integer = SafeDiv(a, b)
    Return q * 2
End Function

Function Main()
    Dim v As Integer = DoubleDiv(10, 2) Handle _
        Debug.Print "failed"
        Return
    End Handle
    Debug.Print "ok: " & v

    Dim ignored As Integer = DoubleDiv(10, 0) Handle _
        Debug.Print "failed"
        Return
    End Handle
    Debug.Print "ok: " & ignored

    Dim v3 As Integer = DoubleDiv(10, -2) Handle err
        Debug.Print "error: " & err
        Return
    End Handle
    Debug.Print "ok: " & v3
End Function
