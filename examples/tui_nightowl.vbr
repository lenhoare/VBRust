' Theme on a Screen — Night Owl (Sarah Drasner's palette) colours the terminal
' chrome, borders, and text. Same `Theme` line as a Window or Page.
Screen Counter
    Title "Night Owl"
    Theme NightOwl

    State
        Dim count As Integer = 0
    End State

    Status "Count: " & count

    View
        Column
            Text "A themed Bust terminal app"
            Text "Count: " & count
        End Column
    End View

    On Key "+" Increment "inc"
    On Key "-" Decrement "dec"
    On Key "q" Quit "quit"

    Event Increment
        count += 1
    End Event

    Event Decrement
        count -= 1
    End Event
End Screen

Function Main()
    Counter.Run
End Function
