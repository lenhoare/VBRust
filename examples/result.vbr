' Errors propagate automatically. Intercept a call with Handle; fail with RaiseError.
Function Main()
    Dim value As Long = Divide(10, 2) Handle message
        Debug.Print "error: " & message
        Return
    End Handle
    Debug.Print "10 / 2 = " & value

    Dim bad As Long = Divide(7, 0) Handle message
        Debug.Print "error: " & message
        Return
    End Handle
    Debug.Print "7 / 0 = " & bad

    ' Failure from Divide flows out of DoubleQuotient with no extra syntax
    Dim doubled As Long = DoubleQuotient(20, 4) Handle message
        Debug.Print "error: " & message
        Return
    End Handle
    Debug.Print "double of 20 / 4 = " & doubled

    Dim known As Long = Divide(9, 3)
    Debug.Print "9 / 3 = " & known
End Function

Function Divide(ByVal numerator As Long, ByVal denominator As Long) As Long
    If denominator = 0 Then
        RaiseError "cannot divide by zero"
    End If
    Return numerator / denominator
End Function

Function DoubleQuotient(ByVal a As Long, ByVal b As Long) As Long
    Dim q As Long = Divide(a, b)
    Return q * 2
End Function
