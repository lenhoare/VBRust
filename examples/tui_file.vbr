' GetOpenFilename / GetSaveAsFilename — VBA-style path prompts on a Screen.
' Tab completes, Enter opens a file or enters a folder (Save As returns even
' a new name), Esc cancels and returns "". Read/Write run off the UI thread
' (`Await` a Function) so the screen doesn't freeze on a slow disk.
Screen Scratch
    Title "Notes"
    Status "F10 File — Open / Save As"

    Menu
        Menu "File"
            Item "Open" OpenFile
            Item "Save As" SaveFile
            Separator
            Item "Quit" Quit
        End Menu
    End Menu

    State
        Dim notes As String = "F10 → File → Open, or Save As. Esc quits."
        Dim path As String = ""
    End State

    View
        Memo notes
        End Memo
    End View

    On Key Esc Quit "quit"

    Sub LoadPicked(ByVal picked As String)
        If picked = "" Then Return
        path = picked.Clone()
        Match Await ReadFile(picked)
            Ok(text) => notes = text
            Err(e) => notes = "Could not read: " & e
        End Match
    End Sub

    Sub SavePicked(ByVal picked As String)
        If picked = "" Then Return
        Match Await WriteFile(picked, notes)
            Ok(saved) => path = saved
            Err(e) => notes = "Could not save: " & e
        End Match
    End Sub

    Event OpenFile
        Dim picked As String = GetOpenFilename(path)
        LoadPicked(picked)
    End Event

    Event SaveFile
        Dim picked As String = GetSaveAsFilename(path)
        SavePicked(picked)
    End Event
End Screen

Function ReadFile(ByVal picked As String) As String
    Return FileSystem.Read(picked)
End Function

Function WriteFile(ByVal picked As String, ByVal text As String) As String
    FileSystem.Write(picked, text)
    Return picked
End Function

Function Main()
    Scratch.Run
End Function
