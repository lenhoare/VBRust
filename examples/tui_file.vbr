' GetOpenFilename / GetSaveAsFilename — VBA-style path prompts on a Screen.
' Tab completes, Enter opens a file or enters a folder (Save As returns even
' a new name), Esc cancels and returns "". Then FileSystem.Read / Write.
Screen Scratch
    Title "Notes"
    Status "F10 File — Open / Save As"

    Menu
        Menu "File"
            Item "Open" OpenFile
            Item "Save As" SaveFile
            Separator
            Item "Quit" Quit
        End Menu
    End Menu

    State
        Dim notes As String = "F10 → File → Open, or Save As. Esc quits."
        Dim path As String = ""
    End State

    View
        Memo notes
        End Memo
    End View

    On Key Esc Quit "quit"

    Event OpenFile
        Dim picked As String = GetOpenFilename(path)
        If picked <> "" Then
            Dim text As String = FileSystem.Read(picked) Handle e
                notes = "Could not read: " & e
                Return
            End Handle
            notes = text
            path = picked
        End If
    End Event

    Event SaveFile
        Dim picked As String = GetSaveAsFilename(path)
        If picked <> "" Then
            FileSystem.Write(picked, notes) Handle e
                notes = "Could not save: " & e
                Return
            End Handle
            path = picked
        End If
    End Event
End Screen

Function Main()
    Scratch.Run
End Function
