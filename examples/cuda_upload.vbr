' CUDA device buffers — Upload, Alloc, Parallel For on the GPU, Download.
Function Main()
    Dim input As Vec<Single> = [1.0, 2.0, 3.0, 4.0]
    Dim n As Long = input.Len()
    Dim a As CudaBuffer<Single> = CUDA.Upload(input)
    Dim b As CudaBuffer<Single> = CUDA.Alloc(n)

    Parallel For i = 0 To n - 1
        b[i] = a[i] * a[i] + 1.0
    Next

    Dim result As Vec<Single> = CUDA.Download(b)
    Debug.Print result[0]
End Function
