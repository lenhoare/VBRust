' `If <expr> Is <pattern> Then …` — VB-flavoured `if let`. Handle just the one
' case you care about (usually Some/Ok), with an optional `Else`. `Is` is VB's
' word (as in VB6's `Is Nothing`). `Do While <expr> Is <pattern>` is `while let`:
' loop while the pattern keeps matching. The Rust backend emits the idiomatic
' `if let` / `loop { if let … else break }`.
Function FindPrice(ByVal item As String) As Option<Long>
    If item = "apple" Then
        Return Some(30)
    End If
    Return None
End Function

Function NextItem(ByRef xs As Vec<Long>, ByVal idx As Long) As Option<Long>
    If idx < xs.Len() Then
        Return Some(xs[idx])
    End If
    Return None
End Function

Function Main()
    If FindPrice("apple") Is Some(price) Then
        Debug.Print "apple costs " & price
    Else
        Debug.Print "no price for apple"
    End If

    If FindPrice("pear") Is Some(price) Then
        Debug.Print "pear costs " & price
    Else
        Debug.Print "no price for pear"
    End If

    ' Single-line form.
    If FindPrice("apple") Is Some(price) Then Debug.Print "again: " & price

    ' while let — drain a list of prices.
    Dim prices As Vec<Long> = [10, 20, 30]
    Dim i As Long = 0
    Do While NextItem(prices, i) Is Some(v)
        Debug.Print "item " & v
        i = i + 1
    Loop
End Function
