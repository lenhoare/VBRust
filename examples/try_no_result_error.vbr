' MEANT to fail — `?` propagates a failure to the caller, so it's only allowed
' in a function that can itself fail (returns Result/Option). `Report` returns
' nothing, so it can't propagate. (`Main` is the one exception: use `?` there
' and VBR gives it a Result return for you.)
Function Main()
    Report()
End Function

Function Report()
    Dim x As Long = MightFail()?
    Debug.Print x
End Function

Function MightFail() As Result<Long>
    Return Ok(5)
End Function
