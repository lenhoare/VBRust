' tui_list_tabs.vbr — a selectable List nested inside a Tabs pane. The List
' is a focusable widget wherever it sits: VBR declares its `<field>_state`
' (the ratatui ListState) and wires Up/Down/Enter even when the widget only
' appears in one pane. Switch tabs with Left/Right (or 1/2) when the tab bar
' is focused; Tab moves focus to the list. Each pane's list keeps its own
' selection.
Screen ListTabs
    Title "Tabbed lists"
    Status "Picked: " & picked

    State
        Dim tab As Integer = 0
        Dim fruit As Vec<String> = ["apple", "pear", "plum"]
        Dim veg As Vec<String> = ["kale", "leek", "bean"]
        Dim picked As String = "nothing yet"
    End State

    View
        Tabs tab
            Tab "Fruit"
                List fruit
                    On Select PickFruit
                End List
            End Tab
            Tab "Veg"
                List veg
                    On Select PickVeg
                End List
            End Tab
        End Tabs
    End View

    On Key "q" Quit "quit"

    Event PickFruit(choice As String)
        picked = "fruit: " & choice
    End Event

    Event PickVeg(choice As String)
        picked = "veg: " & choice
    End Event
End Screen

Function Main()
    ListTabs.Run
End Function
