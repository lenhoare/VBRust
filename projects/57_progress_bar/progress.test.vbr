' 57 — Progress Bar, test file.
Test "progress percentage"
    Assert Progress.Progress(0, 100) = 0
    Assert Progress.Progress(25, 100) = 25
    Assert Progress.Progress(50, 100) = 50
    Assert Progress.Progress(100, 100) = 100
End Test

Test "progress rounds correctly"
    Assert Progress.Progress(1, 3) = 33
    Assert Progress.Progress(2, 3) = 67
End Test

Test "progress guards against zero total"
    Assert Progress.Progress(10, 0) = 0
End Test

Test "chunks are deterministic and in range"
    Assert Progress.NextChunk(0) = 1
    Assert Progress.NextChunk(1) = 3
    Assert Progress.NextChunk(2) = 5
    Dim i As Long = 0
    For i = 0 To 9
        Dim c As Long = Progress.NextChunk(i)
        Assert c >= 1
        Assert c <= 5
    Next
End Test

Test "status and completion"
    Assert Progress.StatusText(12, 45) = "12 MB / 45 MB"
    Assert Not Progress.IsComplete(44, 45)
    Assert Progress.IsComplete(45, 45)
End Test
