' 65 — Shining Carpet logic module.
' Generates the interlocking hexagonal carpet pattern (the Overlook Hotel
' design) as rows of characters. Hexagons are 6 rows tall and 6 columns
' wide; even row-groups tile them side by side, odd row-groups tile them
' offset by half a hexagon (3 columns), which produces the interlocking
' brickwork look.
'
' One hexagon (6 phases):
'   "  /\  "
'   " /  \ "
'   "/    \"
'   "\    /"
'   " \  / "
'   "  \/  "
Public Function Carpet(ByVal cols As Long, ByVal rows As Long) As Vec<String>
    Dim out As Vec<String>
    Dim group As Long = 0
    For group = 0 To rows - 1
        Dim phase As Long = 0
        For phase = 0 To 5
            out.Push(GroupRow(group, phase, cols))
        Next
    Next
    Return out
End Function

' One physical output row: `cols` hexagons at their offset positions.
Public Function GroupRow(ByVal group As Long, ByVal phase As Long, ByVal cols As Long) As String
    Dim offset As Long = 0
    If group Mod 2 = 1 Then
        offset = 3
    End If
    Dim line As String = Spaces(offset)
    Dim c As Long = 0
    For c = 0 To cols - 1
        line = line & HexRow(phase)
    Next
    Return line
End Function

' One hexagon row for the given phase (0..5).
Public Function HexRow(ByVal phase As Long) As String
    If phase = 0 Then
        Return "  /\  "
    ElseIf phase = 1 Then
        Return " /  \ "
    ElseIf phase = 2 Then
        Return "/    \"
    ElseIf phase = 3 Then
        Return "\    /"
    ElseIf phase = 4 Then
        Return " \  / "
    Else
        Return "  \/  "
    End If
End Function

Public Function Spaces(ByVal n As Long) As String
    Dim out As String = ""
    Dim i As Long = 0
    For i = 1 To n
        out = out & " "
    Next
    Return out
End Function
