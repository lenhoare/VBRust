' 26 — Fibonacci, entry point. Prints the first 15 Fibonacci numbers.
Function Main()
    Debug.Print "First 15 Fibonacci numbers:"
    Dim xs As Vec<Long> = Fib.Fibs(15)
    Debug.Print JoinSeq(xs)
    Debug.Print ""
    Debug.Print "Fib(20) = " & Fib.Fib(20)
    Debug.Print "Fib(30) = " & Fib.Fib(30)
End Function

Function JoinSeq(ByVal xs As Vec<Long>) As String
    Dim out As String = ""
    Dim first As Boolean = True
    For Each n In xs
        If first Then
            out = CStr(n)
            first = False
        Else
            out = out & " " & CStr(n)
        End If
    Next
    Return out
End Function
