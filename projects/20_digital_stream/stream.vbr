' 20 — Digital Stream logic module.
' Pure simulation of the Matrix-style "digital rain": columns of 1s and 0s
' cascade down the screen. Each column has a head position that advances at
' its own speed; cells behind the head (within a fixed trail length) are
' lit. The TUI in main.vbr renders one step per tick.
'
' A column is modelled by its head row and speed (rows advanced per tick).
Public Type StreamColumn
    Public Head As Long
    Public Speed As Long
End Type

' One column per lane, spread deterministically by the seed.
Public Function NewColumn(ByVal lane As Long) As StreamColumn
    Return StreamColumn { head: -(lane Mod 10), speed: (lane * 3 Mod 4) + 1 }
End Function

' A full set of `count` columns, one per lane. Used by the Screen's State
' initialiser (State can call module functions, like Life.NewGrid).
Public Function NewColumns(ByVal count As Long) As Vec<StreamColumn>
    Dim out As Vec<StreamColumn>
    Dim i As Long = 0
    For i = 0 To count - 1
        out.Push(NewColumn(i))
    Next
    Return out
End Function

' Advance the column's head one tick; wrap at the field height.
Public Function StepColumn(ByVal col As StreamColumn, ByVal height As Long) As StreamColumn
    Dim nh As Long = col.Head + col.Speed
    If nh >= height Then
        nh = nh Mod height
    End If
    Return StreamColumn { head: nh, speed: col.Speed }
End Function

' Is the cell at `row` lit for this column? Lit if within TRAIL rows above
' the head (the trail), using modular arithmetic so the wrap looks right.
Public Function IsLit(ByVal col As StreamColumn, ByVal row As Long, ByVal height As Long, ByVal trail As Long) As Boolean
    Dim i As Long = 0
    For i = 0 To trail - 1
        Dim r As Long = col.Head - i
        If r < 0 Then
            r = r + height
        End If
        If r = row Then
            Return True
        End If
    Next
    Return False
End Function

' The character for a lit cell, deterministic per row (bit-like pattern).
Public Function BitChar(ByVal row As Long) As String
    If row Mod 3 = 0 Then
        Return "1"
    End If
    Return "0"
End Function
