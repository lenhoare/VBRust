' 24 — Factor Finder, entry point.
Function Main()
    Dim n As Long = 60
    Debug.Print "Factors of " & n & ": " & JoinFactors(Factors.Factors(n))
    Debug.Print ""
    Dim m As Long = 97
    Debug.Print "Factors of " & m & " (prime): " & JoinFactors(Factors.Factors(m))
    Debug.Print ""
    Dim k As Long = 144
    Debug.Print "Factors of " & k & ": " & JoinFactors(Factors.Factors(k))
End Function

Function JoinFactors(ByVal xs As Vec<Long>) As String
    Dim out As String = ""
    Dim first As Boolean = True
    For Each n In xs
        If first Then
            out = CStr(n)
            first = False
        Else
            out = out & ", " & CStr(n)
        End If
    Next
    Return out
End Function
