' 55 — Powerball logic module.
' Pure lottery logic, unit-testable without the DataFrame. main.vbr feeds
' it ticket rows extracted from tickets.csv.
'
' Powerball: 5 white balls (1..69) plus a powerball (1..26). Prizes:
'   jackpot     5 whites + pb match
'   1,000,000   5 whites match (no pb)
'   50,000      4 whites + pb
'   100         4 whites
'   100         3 whites + pb
'   7           3 whites
'   7           2 whites + pb
'   4           1 white + pb
'   4           pb only
'   0           nothing
Public Function Matches(ByVal ticketW As Vec<Long>, ByVal drawW As Vec<Long>) As Long
    Dim count As Long = 0
    Dim i As Long = 0
    For i = 0 To ticketW.Len() - 1
        If InDraw(drawW, ticketW[i]) Then
            count = count + 1
        End If
    Next
    Return count
End Function

' Is `n` one of the draw's white balls?
Public Function InDraw(ByVal draw As Vec<Long>, ByVal n As Long) As Boolean
    Dim i As Long = 0
    For i = 0 To draw.Len() - 1
        If draw[i] = n Then
            Return True
        End If
    Next
    Return False
End Function

' The prize for this ticket, from white matches and whether pb matched.
Public Function Prize(ByVal whiteMatches As Long, ByVal pbHit As Boolean) As Long
    If whiteMatches = 5 And pbHit Then
        Return 100000000
    End If
    If whiteMatches = 5 Then
        Return 1000000
    End If
    If whiteMatches = 4 And pbHit Then
        Return 50000
    End If
    If whiteMatches = 4 Then
        Return 100
    End If
    If whiteMatches = 3 And pbHit Then
        Return 100
    End If
    If whiteMatches = 3 Then
        Return 7
    End If
    If whiteMatches = 2 And pbHit Then
        Return 7
    End If
    If whiteMatches = 1 And pbHit Then
        Return 4
    End If
    If pbHit Then
        Return 4
    End If
    Return 0
End Function

' A human-readable tier label for the prize amount.
Public Function TierName(ByVal prize As Long) As String
    If prize = 100000000 Then
        Return "jackpot"
    ElseIf prize = 1000000 Then
        Return "5 whites"
    ElseIf prize = 50000 Then
        Return "4 + pb"
    ElseIf prize = 100 Then
        Return "100"
    ElseIf prize = 7 Then
        Return "7"
    ElseIf prize = 4 Then
        Return "4"
    Else
        Return "nothing"
    End If
End Function

' The `limit` keys with the largest counts, descending. Deterministic:
' ties keep first-seen order. (Lives here, not main.vbr, so tests can
' reach it — the entry module isn't visible to the test harness.)
Public Function TopByCount(ByVal keys As Vec<Long>, ByVal counts As Vec<Long>, ByVal limit As Long) As Vec<Long>
    Dim out As Vec<Long>
    Dim n As Long = keys.Len()
    Dim used As Vec<Boolean>
    Dim i As Long = 0
    For i = 0 To n - 1
        used.Push(False)
    Next
    Dim taken As Long = 0
    Do While taken < limit And taken < n
        Dim bestIdx As Long = -1
        Dim bestCount As Long = -1
        Dim j As Long = 0
        For j = 0 To n - 1
            If Not used[j] And counts[j] > bestCount Then
                bestCount = counts[j]
                bestIdx = j
            End If
        Next
        If bestIdx >= 0 Then
            out.Push(keys[bestIdx])
            used[bestIdx] = True
            taken = taken + 1
        End If
    Loop
    Return out
End Function

' Index of `v` in `xs`, or -1.
Public Function FindIdx(ByVal xs As Vec<Long>, ByVal v As Long) As Long
    Dim i As Long = 0
    For i = 0 To xs.Len() - 1
        If xs[i] = v Then
            Return i
        End If
    Next
    Return -1
End Function
