' 56 — Prime Numbers, entry point.
Function Main()
    Debug.Print "First 20 primes: " & JoinPrimes(Primes.FirstPrimes(20))
    Debug.Print ""
    Debug.Print "Is 97 prime?   " & Primes.IsPrime(97)
    Debug.Print "Is 100 prime?  " & Primes.IsPrime(100)
    Debug.Print "Is 2 prime?    " & Primes.IsPrime(2)
    Debug.Print ""
    Debug.Print "Primes between 50 and 100: " & JoinPrimes(RangePrimes(50, 100))
End Function

Function RangePrimes(ByVal lo As Long, ByVal hi As Long) As Vec<Long>
    Dim out As Vec<Long>
    Dim n As Long = lo
    For n = lo To hi
        If Primes.IsPrime(n) Then
            out.Push(n)
        End If
    Next
    Return out
End Function

Function JoinPrimes(ByVal xs As Vec<Long>) As String
    Dim out As String = ""
    Dim first As Boolean = True
    For Each n In xs
        If first Then
            out = CStr(n)
            first = False
        Else
            out = out & ", " & CStr(n)
        End If
    Next
    Return out
End Function
