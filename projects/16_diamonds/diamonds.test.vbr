' 16 — Diamonds, test file.
Test "outline row one has no inner space"
    Assert Diamonds.OutlineRow(4, 1) = "   /\"
    Assert Diamonds.OutlineRow(4, 4) = "/      \"
End Test

Test "outline diamond of size two"
    Dim rows As Vec<String> = Diamonds.Outline(2)
    Assert rows.Len() = 3
    Assert rows[0] = " /\"
    Assert rows[1] = "/  \"
    Assert rows[2] = " /\"
End Test

Test "filled row star counts"
    Assert Diamonds.FilledRow(3, 1) = "  *"
    Assert Diamonds.FilledRow(3, 2) = " ***"
    Assert Diamonds.FilledRow(3, 3) = "*****"
End Test

Test "filled diamond of size three"
    Dim rows As Vec<String> = Diamonds.Filled(3)
    Assert rows.Len() = 5
    Assert rows[0] = "  *"
    Assert rows[1] = " ***"
    Assert rows[2] = "*****"
    Assert rows[3] = " ***"
    Assert rows[4] = "  *"
End Test

Test "spaces helper"
    Assert Diamonds.Spaces(0) = ""
    Assert Diamonds.Spaces(3) = "   "
End Test
