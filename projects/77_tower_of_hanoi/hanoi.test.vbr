' 77 — Tower of Hanoi, test file.
Test "one disk is a single move"
    Assert Hanoi.Solve(1) = ["1->3"]
End Test

Test "two disks in three moves"
    Assert Hanoi.Solve(2) = ["1->2", "1->3", "2->3"]
End Test

Test "three disks in seven moves"
    Assert Hanoi.Solve(3) = ["1->3", "1->2", "3->2", "1->3", "2->1", "2->3", "1->3"]
End Test

Test "move count is two to the n minus one"
    Assert Hanoi.Solve(1).Len() = 1
    Assert Hanoi.Solve(2).Len() = 3
    Assert Hanoi.Solve(3).Len() = 7
    Assert Hanoi.Solve(4).Len() = 15
    Assert Hanoi.Solve(5).Len() = 31
End Test

Test "every move is between valid pegs"
    Dim moves As Vec<String> = Hanoi.Solve(4)
    For Each m In moves
        Assert m.Len() = 4
        Assert Mid(m, 2, 1) = "-"
        Assert Mid(m, 3, 1) = ">"
        Assert Val(Mid(m, 1, 1)) >= 1
        Assert Val(Mid(m, 1, 1)) <= 3
        Assert Val(Mid(m, 4, 1)) >= 1
        Assert Val(Mid(m, 4, 1)) <= 3
    Next
End Test
