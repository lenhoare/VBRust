' Bust Screen template — structure only. Open in tide_design.
' Chart above a data table. Lotus 1-2-3, Excel chart sheet, report.
Screen ChartReport
    Title "Report"

    Menu
        Menu "File"
            Item "Export" ExportReport
            Separator
            Item "Quit" Quit
        End Menu
        Menu "View"
            Item "Refresh" Refresh
        End Menu
    End Menu

    View
        Column
            Length 1
            Text "Trend"
            Fill
            Chart curve
            Length 1
            Text "Figures"
            Percent 40
            Table figures
                On Select FigureSelected
            End Table
            Length 1
            Row
                Length 1
                Button "Refresh"
                    On Click Refresh
                End Button
                Length 1
                Button "Export"
                    On Click ExportReport
                End Button
            End Row
        End Column
    End View
End Screen
