' A grain exchange. Tab to the table, Enter to take a lot, type a new listing.
' Run:  vbr runproject goodexamples/exchange

Screen Floor
    Title "Exchange"
    Status status

    State
        Dim lots As Vec<Lot> = Pit.OpenBoard()
        Dim ticket As String = ""
        Dim status As String = "Enter takes a lot · type wheat 12 4.50 to list one"
    End State

    View
        Column
            Length 1
            Text " Tab between box and table · Esc quits"
            Length 3
            Input ticket
                On Submit ListIt
            End Input
            Fill
            Table lots
                On Select TakeLot
            End Table
            Length 1
            Text " " & status
        End Column
    End View

    On Key Esc Quit

    Event ListIt(text As String)
        Pit.ListLot(lots, text) Handle err
            status = err
            Return
        End Handle
        ticket = ""
        status = "listed"
    End Event

    Event TakeLot(lot As Lot)
        Pit.Take(lots, lot) Handle err
            status = err
            Return
        End Handle
        status = "took " & Pit.LabelOf(lot)
    End Event
End Screen

Function Main()
    Floor.Run
End Function
