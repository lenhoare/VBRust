' A sunflower head. Each seed sits on the golden spiral — angle 2π/φ².

Public Type Peg
    Public X As Long
    Public Y As Long
    Public Warm As Long
End Type

Public Function At(ByVal i As Long) As Peg
    Dim a As Double = i * 3.14159 * (3.0 - Sqr(5.0))
    Dim r As Double = 8.2 * Sqr(i)
    Dim warm As Long = 90 + (i Mod 140)
    Return Peg { x: Int(320.0 + Cos(a) * r), y: Int(250.0 + Sin(a) * r), warm: warm }
End Function
