' A ship's hold. Capacity is fixed; Load RaiseError's when a crate will not fit.
' Destinations are tallied so the bosun can see what is bound where.

Public Const CAPACITY As Long = 8000

Public Type Crate
    Public Name As String
    Public Dest As String
    Public Kg As Long
End Type

Public Type Hold
    Public Items As Vec<Crate>
End Type

Public Function Hold.Weight() As Long
    Dim n As Long = 0
    For Each c In Me.Items
        n = n + c.Kg
    Next
    Return n
End Function

Public Function Hold.Dump() As String
    If Me.Items.Len() = 0 Then
        Return "(hold is empty)"
    End If
    Dim out As String = ""
    For Each c In Me.Items
        out = out & "  " & c.Kg & " kg  " & c.Name & " → " & c.Dest & Chr(10)
    Next
    Return out
End Function

Public Function Hold.ByDest() As String
    Dim sums As HashMap<String, Long>
    For Each c In Me.Items
        Dim dest As String = c.Dest.Clone()
        Dim kg As Long = c.Kg
        If sums.get(dest) Is Some(sofar) Then
            sums.Insert(dest, sofar + kg)
        Else
            sums.Insert(dest, kg)
        End If
    Next
    Dim out As String = ""
    For Each port, n In sums
        out = out & "  " & port & ": " & n & " kg" & Chr(10)
    Next
    If out = "" Then
        Return "(nothing stowed)"
    End If
    Return out
End Function

Public Function Stow(ByRef h As Hold, ByVal name As String, ByVal dest As String, ByVal kg As Long)
    Dim n As String = Trim(name)
    Dim d As String = LCase(Trim(dest))
    If n = "" Then
        RaiseError "crate needs a name — try: stow coffee london 120"
    End If
    If d = "" Then
        RaiseError "crate needs a destination"
    End If
    If kg <= 0 Then
        RaiseError "weight must be a positive number of kilograms"
    End If
    If h.Weight() + kg > CAPACITY Then
        RaiseError "hold is full — " & h.Weight() & " kg of " & CAPACITY & " already aboard"
    End If
    h.Items.Push(Crate { name: n, dest: d, kg: kg })
End Function

Public Function Load(ByVal path As String) As Hold
    Dim items As Vec<Crate>
    If Not FileSystem.Exists(path) Then
        Return Hold { items: items }
    End If
    Dim lines As Vec<String> = FileSystem.Read_Lines(path)
    Dim i As Long
    For i = 0 To lines.Len() - 1
        Dim line As String = Trim(lines[i])
        If line = "" Then
            Continue
        End If
        If TryCrate(line) Is Some(c) Then
            items.Push(c)
        End If
    Next
    Return Hold { items: items }
End Function

Function TryCrate(ByVal line As String) As Option<Crate>
    Dim c As Crate = ParseCrate(line) Handle err
        Debug.Print "  skipping bad crate: " & err
        Return None
    End Handle
    Return Some(c)
End Function

Function ParseCrate(ByVal line As String) As Crate
    Dim parts As Vec<String> = SplitBars(line)
    If parts.Len() < 3 Then
        RaiseError "want name|dest|kg"
    End If
    Dim kg As Long = CLng(parts[2])
    If kg <= 0 Then
        RaiseError "kg must be positive"
    End If
    Return Crate { name: parts[0], dest: LCase(parts[1]), kg: kg }
End Function

Public Function Hold.Save(ByVal path As String)
    Dim body As String = ""
    For Each c In Me.Items
        body = body & c.Name & "|" & c.Dest & "|" & c.Kg & Chr(10)
    Next
    FileSystem.Write(path, body)
End Function

Function SplitBars(ByVal line As String) As Vec<String>
    Dim out As Vec<String>
    Dim cur As String = ""
    Dim i As Long
    For i = 1 To Len(line)
        Dim ch As String = Mid(line, i, 1)
        If ch = "|" Then
            out.Push(Trim(cur))
            cur = ""
        Else
            cur = cur & ch
        End If
    Next
    out.Push(Trim(cur))
    Return out
End Function
