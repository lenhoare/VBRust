' A small vault: folder list on the left, markdown on the right.
' Theme JellyFish. Drag the divider. Open picks a folder. Run:  vbr runproject goodexamples/vault

Window Vault
    Title "Vault"
    Theme JellyFish

    State
        Dim root As String = "vault"
        Dim folder As String = "vault"
        Dim names As Vec<String> = Entries("vault", "vault")
        Dim current As String = "welcome.md"
        Dim draft As TextArea = SeedText()
        Dim pane As Integer = 0
        Dim status As String = "vault/welcome.md"
    End State

    View
        Column
            Padding 12
            Fill
            Split Vertical 0.28
                Spacing 4
                Frame "Vault"
                    List names
                        On Select OpenNote
                    End List
                End Frame
                Column
                    Spacing 8
                    Fill
                    Tabs pane
                        Tab "Edit"
                            Column
                                Fill
                                TextArea draft
                            End Column
                        End Tab
                        Tab "Preview"
                            Scrollable
                                Markdown draft.Text()
                            End Scrollable
                        End Tab
                    End Tabs
                    Row
                        Spacing 10
                        Button "Open"
                            On Click OpenVault
                        End Button
                        Button "Save"
                            On Click SaveNote
                        End Button
                        Text status
                    End Row
                End Column
            End Split
        End Column
    End View

    Event OpenVault
        Dim picked As String = GetFolderName(folder)
        If picked = "" Then
            Return
        End If
        folder = picked
        root = folder.Clone()
        names = Entries(folder, root)
        current = ""
        status = folder.Clone()
    End Event

    Event OpenNote(name As String)
        If name = "../" Then
            folder = FileSystem.Parent(folder)
            names = Entries(folder, root)
            current = ""
            status = folder.Clone()
        ElseIf name.ends_with("/") Then
            folder = FileSystem.Join(folder, name)
            names = Entries(folder, root)
            current = ""
            status = folder.Clone()
        Else
            Dim path As String = FileSystem.Join(folder, name)
            current = name
            Dim text As String = FileSystem.Read(path) Handle err
                status = err
                Return
            End Handle
            status = path
            draft = text
        End If
    End Event

    Event SaveNote
        If current = "" Then
            status = "pick a file first"
            Return
        End If
        Dim path As String = FileSystem.Join(folder, current)
        FileSystem.Write(path, draft.Text()) Handle err
            status = err
            Return
        End Handle
        status = "saved " & path
    End Event
End Window

Function SeedText() As String
    Dim text As String = FileSystem.Read("vault/welcome.md") Handle _
        Return "# Welcome" & vbNewLine & vbNewLine & "click a file on the left."
    End Handle
    Return text
End Function

Function Entries(folder As String, root As String) As Vec<String>
    If folder = "vault" Then
        EnsureVault()
    End If
    Dim names As Vec<String> = FileSystem.List(folder) Handle _
        Dim empty As Vec<String>
        Return empty
    End Handle
    If folder <> root Then
        Dim listed As Vec<String>
        listed.Push("../")
        listed.Extend(names)
        Return listed
    End If
    Return names
End Function

Function EnsureVault()
    If FileSystem.Folder_Exists("vault") Then
        Return
    End If
    FileSystem.Create_Folder_All("vault") Handle _
        Return
    End Handle
    FileSystem.Write("vault/welcome.md", "# Welcome" & vbNewLine & vbNewLine & "click a file on the left.") Handle _
        Return
    End Handle
End Function

Function Main()
    Vault.Run
End Function
