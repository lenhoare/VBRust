' A small vault: folder list on the left, markdown on the right.
' Theme JellyFish. Drag the divider. Open picks a folder. Run:  vbr runproject goodexamples/vault
'
' Disk work (List / Read / Write) lives in Functions the Events `Await`, so a
' slow disk can't freeze the window. GetFolderName stays in the Event (it needs
' the live Window).

Type NoteNav
    Public Folder As String
    Public Names As Vec<String>
    Public Current As String
    Public Draft As String
    Public Status As String
    Public HasDraft As Boolean
End Type

Window Vault
    Title "Vault"
    Theme JellyFish

    State
        Dim root As String = "vault"
        Dim folder As String = "vault"
        Dim names As Vec<String> = Entries("vault", "vault")
        Dim current As String = "welcome.md"
        Dim draft As TextArea = SeedText()
        Dim pane As Integer = 0
        Dim status As String = "vault/welcome.md"
    End State

    View
        Column
            Padding 12
            Fill
            Split Vertical 0.28
                Spacing 4
                Frame "Vault"
                    List names
                        On Select OpenNote
                    End List
                End Frame
                Column
                    Spacing 8
                    Fill
                    Tabs pane
                        Tab "Edit"
                            Column
                                Fill
                                TextArea draft
                            End Column
                        End Tab
                        Tab "Preview"
                            Scrollable
                                Markdown draft.Text()
                            End Scrollable
                        End Tab
                    End Tabs
                    Row
                        Spacing 10
                        Button "Open"
                            On Click OpenVault
                        End Button
                        Button "Save"
                            On Click SaveNote
                        End Button
                        Text status
                    End Row
                End Column
            End Split
        End Column
    End View

    Sub LoadVault(ByVal picked As String)
        If picked = "" Then Return
        Match Await OpenFolderWork(picked)
            Ok(nav) =>
                folder = nav.Folder
                root = nav.Folder
                names = nav.Names
                current = ""
                status = nav.Status
            Err(e) => status = e
        End Match
    End Sub

    Event OpenVault
        Dim picked As String = GetFolderName(folder)
        LoadVault(picked)
    End Event

    Event OpenNote(name As String)
        Match Await OpenNoteWork(name, folder, root)
            Ok(nav) =>
                folder = nav.Folder
                names = nav.Names
                current = nav.Current
                status = nav.Status
                If nav.HasDraft Then
                    draft = nav.Draft
                End If
            Err(e) => status = e
        End Match
    End Event

    Event SaveNote
        Match Await SaveNoteWork(current, folder, draft.Text())
            Ok(msg) => status = msg
            Err(e) => status = e
        End Match
    End Event
End Window

Function OpenFolderWork(ByVal picked As String) As NoteNav
    Dim listed As Vec<String> = Entries(picked.Clone(), picked)
    Return NoteNav { Folder: picked, Names: listed, Current: "", Draft: "", Status: picked.Clone(), HasDraft: False }
End Function

Function OpenNoteWork(ByVal name As String, ByVal folder As String, ByVal root As String) As NoteNav
    If name = "../" Then
        Dim up As String = FileSystem.Parent(folder)
        Dim listed As Vec<String> = Entries(up, root)
        Return NoteNav { Folder: up, Names: listed, Current: "", Draft: "", Status: up.Clone(), HasDraft: False }
    End If
    If name.ends_with("/") Then
        Dim down As String = FileSystem.Join(folder, name)
        Dim listed As Vec<String> = Entries(down, root)
        Return NoteNav { Folder: down, Names: listed, Current: "", Draft: "", Status: down.Clone(), HasDraft: False }
    End If
    Dim path As String = FileSystem.Join(folder, name)
    Dim text As String = FileSystem.Read(path)
    Return NoteNav { Folder: folder.Clone(), Names: Entries(folder, root), Current: name, Draft: text, Status: path, HasDraft: True }
End Function

Function SaveNoteWork(ByVal current As String, ByVal folder As String, ByVal text As String) As String
    If current = "" Then
        Return "pick a file first"
    End If
    Dim path As String = FileSystem.Join(folder, current)
    FileSystem.Write(path, text)
    Return "saved " & path
End Function

Function SeedText() As String
    Dim text As String = FileSystem.Read("vault/welcome.md") Handle _
        Return "# Welcome" & vbNewLine & vbNewLine & "click a file on the left."
    End Handle
    Return text
End Function

Function Entries(folder As String, root As String) As Vec<String>
    If folder = "vault" Then
        EnsureVault()
    End If
    Dim names As Vec<String> = FileSystem.List(folder) Handle _
        Dim empty As Vec<String>
        Return empty
    End Handle
    If folder <> root Then
        Dim listed As Vec<String>
        listed.Push("../")
        listed.Extend(names)
        Return listed
    End If
    Return names
End Function

Function EnsureVault()
    If FileSystem.Folder_Exists("vault") Then
        Return
    End If
    FileSystem.Create_Folder_All("vault") Handle _
        Return
    End Handle
    FileSystem.Write("vault/welcome.md", "# Welcome" & vbNewLine & vbNewLine & "click a file on the left.") Handle _
        Return
    End Handle
End Function

Function Main()
    Vault.Run
End Function
