{
  "name": "vbr-lsp",
  "displayName": "VBR Language Support",
  "description": "Language assistance for VBR — live diagnostics (proof of concept).",
  "version": "0.0.1",
  "publisher": "vbr",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vbr.runFile",
        "title": "VBR: Run File",
        "category": "VBR",
        "icon": "$(play)"
      },
      {
        "command": "vbr.showRustOutput",
        "title": "VBR: Open Rust Output to the Side",
        "category": "VBR",
        "icon": "$(split-horizontal)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "vbr.runFile",
          "when": "resourceLangId == vbr || resourceLangId == rust",
          "group": "navigation@1"
        },
        {
          "command": "vbr.showRustOutput",
          "when": "resourceLangId == vbr",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "vbr.runFile",
          "when": "resourceLangId == vbr || resourceLangId == rust"
        },
        {
          "command": "vbr.showRustOutput",
          "when": "resourceLangId == vbr"
        }
      ]
    },
    "keybindings": [
      {
        "command": "vbr.runFile",
        "key": "ctrl+alt+r",
        "when": "editorTextFocus && (editorLangId == vbr || editorLangId == rust)"
      }
    ],
    "languages": [
      {
        "id": "vbr",
        "aliases": [
          "VBR",
          "vbr"
        ],
        "extensions": [
          ".vbr"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "vbr",
        "scopeName": "source.vbr",
        "path": "./syntaxes/vbr.tmLanguage.json"
      },
      {
        "scopeName": "vbr.embedded.injection",
        "path": "./syntaxes/vbr.injection.json",
        "injectTo": ["source.rust"]
      }
    ],
    "configuration": {
      "title": "VBR",
      "properties": {
        "vbr.serverPath": {
          "type": "string",
          "default": "",
          "description": "Path to the vbr-lsp server binary. If empty, the extension looks for it at ../../vbr-lsp/target/release/vbr-lsp (and honours the VBR_LSP_SERVER environment variable)."
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.0"
  }
}
